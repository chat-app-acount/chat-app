rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function siteAdmin() {
      return signedIn()
        && request.auth.token.email == 'yui.rugby.1128@gmail.com';
    }
    function userBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }
    function activeUser() {
      return signedIn() && !userBanned();
    }
    function roomData(id) {
      return get(/databases/$(database)/documents/rooms/$(id)).data;
    }
    function roomMember(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(id))
        && request.auth.uid in roomData(id).get('members', []);
    }
    function roomAdmin(id) {
      return roomMember(id)
        && (roomData(id).get('createdBy', '') == request.auth.uid
          || request.auth.uid in roomData(id).get('admins', []));
    }
    function canRoomPost(id) {
      return roomMember(id)
        && (!roomData(id).get('postAdminOnly', false) || roomAdmin(id) || siteAdmin());
    }
    function canRoomImage(id) {
      return roomMember(id)
        && (!roomData(id).get('imageAdminOnly', false) || roomAdmin(id) || siteAdmin());
    }
    function dmMember(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/dms/$(id))
        && request.auth.uid in get(/databases/$(database)/documents/dms/$(id)).data.get('members', []);
    }
    function roomActivityKeys() {
      return ['lastMsg','lastMsgTs','lastUid','lastMentions','typing',
        'callId','callState','callFrom','callTs'];
    }
    function dmActivityKeys() {
      return ['lastMsg','lastMsgTs','lastUid','lastMentions','typing',
        'callId','callState','callFrom','callTs'];
    }
    function ownMessageUpdate() {
      return resource.data.get('author', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text','edited','deleted','hasImage','hasFull','image']);
    }
    function memberMessageReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['readBy','reactions','votes','poll','game']);
    }

    match /users/{uid} {
      // ChatSpace 3.8 loads the user directory for friend/DM selection.
      // Profile fields are therefore readable to signed-in members.
      allow read: if activeUser();
      allow create: if activeUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid','name','email','photoURL','photo','color','online','lastSeen','createdAt'
        ])
        && request.resource.data.uid == uid;
      allow update: if activeUser() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name','photo','color','online','lastSeen']))
        || (siteAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['banned','banReason']))
      );
      allow delete: if false;

      match /private/{doc} {
        allow read, write: if activeUser() && request.auth.uid == uid;
      }
      match /memos/{rid} {
        allow read, write: if activeUser() && request.auth.uid == uid;
      }
    }

    match /invites/{id} {
      allow read: if activeUser();
      allow create, update, delete: if false;
    }

    match /rooms/{id} {
      // A room code must be readable before a user can join.
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('members', []).hasAll([request.auth.uid])
        && request.resource.data.get('admins', []).size() == 0
        && (id != 'all' || siteAdmin());

      allow update: if activeUser() && (
        siteAdmin()
        || (
          resource.data.get('createdBy', '') == request.auth.uid
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('members', []).hasAll([resource.data.get('createdBy', '')])
        )
        || (
          roomAdmin(id)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdBy','admins'])
        )
        || (
          roomMember(id)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(roomActivityKeys())
        )
        || (
          activeUser()
          && !(request.auth.uid in resource.data.get('banned', []))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
          && request.resource.data.members.toSet()
            .difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
          && resource.data.members.toSet()
            .difference(request.resource.data.members.toSet()).size() == 0
          && request.resource.data.members.size() <= resource.data.members.size() + 1
        )
        || (
          roomMember(id)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
          && resource.data.members.toSet()
            .difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.members.toSet()
            .difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.size() == resource.data.members.size() - 1
        )
      );
      allow delete: if activeUser()
        && (siteAdmin() || roomAdmin(id));

      match /messages/{mid} {
        allow read: if activeUser() && (roomMember(id) || siteAdmin());
        allow create: if activeUser() && canRoomPost(id)
          && (
            (request.resource.data.get('type', '') == 'system'
              && !request.resource.data.keys().hasAny(['author']))
            || request.resource.data.get('author', '') == request.auth.uid
          )
          && (!request.resource.data.get('hasImage', false) || canRoomImage(id));
        allow update: if activeUser() && roomMember(id) && (
          ownMessageUpdate()
          || memberMessageReactionUpdate()
          || (roomAdmin(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']))
        );
        allow delete: if activeUser() && (roomAdmin(id)
          || resource.data.get('author', '') == request.auth.uid);
      }

      match /images/{iid} {
        allow read: if activeUser() && (roomMember(id) || siteAdmin());
        allow create: if activeUser() && canRoomImage(id)
          && request.resource.data.get('author', '') == request.auth.uid;
        allow update: if false;
        allow delete: if activeUser()
          && (roomAdmin(id) || resource.data.get('author', '') == request.auth.uid);
      }

      match /calls/{callId} {
        allow read, write: if activeUser() && roomMember(id);
        match /{sub=**} {
          allow read, write: if activeUser() && roomMember(id);
        }
      }
    }

    match /dms/{id} {
      allow read: if activeUser() && (
        !exists(/databases/$(database)/documents/dms/$(id)) || dmMember(id)
      );
      allow create: if activeUser()
        && request.resource.data.get('members', []).size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if activeUser() && dmMember(id)
        && request.resource.data.get('members', []) == resource.data.get('members', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(dmActivityKeys());
      allow delete: if activeUser() && dmMember(id);

      match /messages/{mid} {
        allow read: if activeUser() && dmMember(id);
        allow create: if activeUser() && dmMember(id)
          && (
            request.resource.data.get('type', '') == 'system'
            || request.resource.data.get('author', '') == request.auth.uid
          );
        allow update: if activeUser() && dmMember(id) && (
          ownMessageUpdate() || memberMessageReactionUpdate()
        );
        // A DM participant can clear the shared conversation when deleting the DM.
        allow delete: if activeUser() && dmMember(id);
      }
      match /images/{iid} {
        allow read: if activeUser() && dmMember(id);
        allow create: if activeUser() && dmMember(id)
          && request.resource.data.get('author', '') == request.auth.uid;
        allow update: if false;
        allow delete: if activeUser() && dmMember(id)
          && resource.data.get('author', '') == request.auth.uid;
      }
      match /calls/{callId} {
        allow read, write: if activeUser() && dmMember(id);
        match /{sub=**} {
          allow read, write: if activeUser() && dmMember(id);
        }
      }
    }

    match /config/{doc} {
      allow read: if activeUser();
      allow write: if siteAdmin();
    }
    match /adminLog/{id} {
      allow read, create: if siteAdmin();
      allow update, delete: if false;
    }
    match /reports/{id} {
      allow create: if activeUser()
        && request.resource.data.get('byUid', '') == request.auth.uid;
      allow read: if siteAdmin();
      allow update, delete: if siteAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}